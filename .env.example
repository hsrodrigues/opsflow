# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA cometa o ".env" real no controle de versão — ele está no .gitignore.

# --- Geral ---
APP_NAME="OpsFlow API"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- Banco de dados (MySQL 8+) ---
DATABASE_URL=mysql+pymysql://opsflow:opsflow@127.0.0.1:3306/opsflow_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# --- Segurança / JWT ---
# Gere um valor forte, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Redis (reservado — não usado na Fase 1) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- API ---
API_V1_PREFIX=/api/v1
CORS_ALLOW_ORIGINS=["http://localhost"]
RATE_LIMIT_PER_MINUTE=120
# Desligue só em testes automatizados (derrubaria a suíte com 429s) — ver
# docs/SECURITY.md.
RATE_LIMITING_ENABLED=true
# Restrinja ao(s) domínio(s) reais antes de expor a API publicamente
# (mitiga ataques de Host header) — "*" (default) não restringe nada.
ALLOWED_HOSTS=["*"]

# --- Servidor de licenças ---
LICENSE_SERVER_URL=

# --- SMTP (e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@opsflow.local
SMTP_USE_TLS=true

# --- Logging ---
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Seed de demonstração (database/seeds/seed_demo.py) ---
# Se omitido, o script gera uma senha aleatória e a imprime uma única vez.
SEED_ADMIN_EMAIL=admin@opsflow.local
SEED_ADMIN_PASSWORD=

# --- Jobs em background (app/jobs/) — todos têm default, raramente precisa mexer ---
JOBS_ENABLED=true
DELAY_DETECTION_INTERVAL_MINUTES=5
CNH_ALERT_INTERVAL_HOURS=24
LICENSE_EXPIRATION_INTERVAL_MINUTES=60
STALE_OPERATIONS_INTERVAL_MINUTES=60
STALE_OPERATION_HOURS=24

# --- Backup do banco (app/jobs/backup_job.py) ---
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
# Só necessário no Windows, quando mysqldump/mysql não estão no PATH (o
# instalador padrão do MySQL não adiciona) — aponte pra pasta bin/ da
# instalação, ex.: C:\Program Files\MySQL\MySQL Server 8.0\bin
MYSQL_BIN_DIR=
