# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg
.venv/
venv/
env/
.python-version

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Banco local de desenvolvimento (SQLite, apenas quando não há MySQL disponível) ---
*.db
*.sqlite3
*.db-journal

# --- Logs ---
logs/*.log
logs/*.log.*
logs/auto-sync.log

# --- Backups do banco (app/jobs/backup_job.py) — dumps reais de clientes,
# nunca versionados; ficam só no disco de quem roda o backend ---
backend/backups/
backups/

# --- Tests / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Tooling ---
.mypy_cache/
.ruff_cache/

# --- Desktop build artifacts ---
desktop/build/
desktop/dist/

# --- Installer output --- (installer/opsflow.spec IS committed — it's the
# build recipe, not an artifact; only its generated .exe/.iss output isn't)
installer/*.exe

# --- IDE / OS ---
.vscode/
.idea/
.claude/
Thumbs.db
.DS_Store
